# ── SmartQueue Environment Configuration Example ─────────────────────────────
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.

# ── Environment & Application ────────────────────────────────────────────────
# Allowed values: development | production | test
ENVIRONMENT=development
APP_NAME=SmartQueue
APP_VERSION=0.1.0

# In production, set to false to disable public Swagger/OpenAPI documentation
DOCS_ENABLED=true

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for local development:
DATABASE_URL=sqlite:///./smartqueue.db

# PostgreSQL for hosted production (Render / Supabase / Neon / RDS):
# DATABASE_URL=postgresql://username:password@hostname:5432/smartqueue_db

# ── Security & Authentication ────────────────────────────────────────────────
# Must be a cryptographically secure, random secret key (minimum 32 characters in production)
JWT_SECRET_KEY=smartqueue-dev-secret-key-must-change-in-production-min-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ESP32 Device Authentication Headers
DEVICE_ID_HEADER=X-Device-ID
DEVICE_KEY_HEADER=X-Device-Key

# ── Patient Frontend ─────────────────────────────────────────────────────────
# The public URL embedded in QR codes for patients to access registration
PATIENT_FRONTEND_URL=http://localhost:8000/patient/

# ── CORS Allowlist ───────────────────────────────────────────────────────────
# Comma-separated list or JSON list of allowed origins.
# Use wildcard '*' only for local development. For production:
# CORS_ORIGINS=["https://patient.yourhospital.com","https://staff.yourhospital.com","https://display.yourhospital.com"]
CORS_ORIGINS=["*"]

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
