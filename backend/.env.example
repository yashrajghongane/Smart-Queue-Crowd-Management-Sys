# Copy this to .env and adjust values for your environment.
# Never commit .env to git.

# Database URL
# SQLite for development:
DATABASE_URL=sqlite:///./smartqueue.db
# PostgreSQL for hosted deployment (uncomment and fill in when deploying):
# DATABASE_URL=postgresql://user:password@host:5432/smartqueue

# Application
APP_VERSION=0.1.0
APP_NAME=SmartQueue

# Patient frontend URL — used to generate the registration QR code URL.
# Change this to your hosted domain when deploying to production.
# Example: https://yourapp.example.com/patient/
PATIENT_FRONTEND_URL=http://localhost:8000/patient/
